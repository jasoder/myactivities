# Database
DATABASE_URL=postgresql+asyncpg://postgres:myactivities@db:5432/myactivities-test

# AI Configuration (Optional: built-in fallback simulator used if omitted)
AI_API_URL=http://localhost:11434/v1
AI_API_KEY=your_api_key_here
