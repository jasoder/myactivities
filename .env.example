# Database
DATABASE_URL=postgresql+asyncpg://postgres:myactivities@db:5432/myactivities-test

# AI Configuration (Optional: fallback simulator used if not configured)
# Supported Providers: anthropic | openai | openrouter | ollama

# Option 1: Anthropic (Default)
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-api03-...
# AI_MODEL=claude-3-5-sonnet-20241022

# Option 2: OpenAI
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-proj-...
# AI_MODEL=gpt-4o

# Option 3: OpenRouter
# AI_PROVIDER=openrouter
# AI_API_KEY=sk-or-v1-...
# AI_MODEL=anthropic/claude-3.5-sonnet

# Option 4: Local Ollama (Free / Local)
# AI_PROVIDER=ollama
# AI_API_URL=http://localhost:11434/v1/chat/completions
# AI_MODEL=llama3.2

# Generic Overrides
# AI_API_URL=https://api.anthropic.com/v1/messages
# AI_API_KEY=...
# AI_MODEL=...

# Strava Integration
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_VERIFY_TOKEN=
